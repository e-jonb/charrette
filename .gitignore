# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Private / sensitive context files
contexts/*.private.md
knowledge/*.private.md
handoffs/*.private.md

# Node (if any tooling is added later)
node_modules/

# Claude Code - commit repo-level config, ignore machine-local overrides.
# Kept here rather than in a global gitignore on purpose: global config does not
# travel to another machine or to anyone who clones this repo, so relying on it
# means the file is protected only where someone happened to set it up.
.claude/settings.local.json
